<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Mitlex" targetNamespace="https://mitlex.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:process id="Mitlex_Procurement_Process" name="Закупка материалов: от заявки до контроля поставки" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Mitlex">
      <bpmn:lane id="Lane_Delivery" name="Контроль поставки">
        <bpmn:flowNodeRef>DeliveryReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CreateDeliveryControl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Accounting" name="Бухгалтерия">
        <bpmn:flowNodeRef>PayInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AttachPaymentOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Финансы">
        <bpmn:flowNodeRef>ReviewBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InvoiceApproved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Снабжение">
        <bpmn:flowNodeRef>RegisterRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendToFinance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ResolveSupplyIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Initiator" name="Инициатор">
        <bpmn:flowNodeRef>CreateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ClarifyRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Потребность в материалах" />
    <bpmn:userTask id="CreateRequest" name="Создать заявку: материалы, объект, срок, вложения" />
    <bpmn:userTask id="RegisterRequest" name="Зарегистрировать заявку и назначить ответственного" />
    <bpmn:exclusiveGateway id="RequestComplete" name="Заявка полная?" />
    <bpmn:userTask id="ClarifyRequest" name="Уточнить заявку" />
    <bpmn:userTask id="SelectSupplier" name="Проверить потребность, выбрать поставщика и получить счёт" />
    <bpmn:userTask id="SendToFinance" name="Передать счёт на согласование" />
    <bpmn:userTask id="ReviewBudget" name="Проверить бюджет и согласовать счёт" />
    <bpmn:exclusiveGateway id="InvoiceApproved" name="Счёт согласован?" />
    <bpmn:userTask id="ResolveSupplyIssue" name="Уточнить условия / заменить поставщика" />
    <bpmn:userTask id="PayInvoice" name="Провести оплату" />
    <bpmn:userTask id="AttachPaymentOrder" name="Приложить платёжное поручение" />
    <bpmn:userTask id="CreateDeliveryControl" name="Поставить задачу на контроль поставки" />
    <bpmn:userTask id="DeliveryReceived" name="Подтвердить поставку и закрывающие документы" />
    <bpmn:endEvent id="End" name="Заявка завершена" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="CreateRequest" />
    <bpmn:sequenceFlow id="F2" sourceRef="CreateRequest" targetRef="RegisterRequest" />
    <bpmn:sequenceFlow id="F3" sourceRef="RegisterRequest" targetRef="RequestComplete" />
    <bpmn:sequenceFlow id="F4" name="Нет" sourceRef="RequestComplete" targetRef="ClarifyRequest" />
    <bpmn:sequenceFlow id="F5" sourceRef="ClarifyRequest" targetRef="RegisterRequest" />
    <bpmn:sequenceFlow id="F6" name="Да" sourceRef="RequestComplete" targetRef="SelectSupplier" />
    <bpmn:sequenceFlow id="F7" sourceRef="SelectSupplier" targetRef="SendToFinance" />
    <bpmn:sequenceFlow id="F8" sourceRef="SendToFinance" targetRef="ReviewBudget" />
    <bpmn:sequenceFlow id="F9" sourceRef="ReviewBudget" targetRef="InvoiceApproved" />
    <bpmn:sequenceFlow id="F10" name="Нет" sourceRef="InvoiceApproved" targetRef="ResolveSupplyIssue" />
    <bpmn:sequenceFlow id="F11" sourceRef="ResolveSupplyIssue" targetRef="SelectSupplier" />
    <bpmn:sequenceFlow id="F12" name="Да" sourceRef="InvoiceApproved" targetRef="PayInvoice" />
    <bpmn:sequenceFlow id="F13" sourceRef="PayInvoice" targetRef="AttachPaymentOrder" />
    <bpmn:sequenceFlow id="F14" sourceRef="AttachPaymentOrder" targetRef="CreateDeliveryControl" />
    <bpmn:sequenceFlow id="F15" sourceRef="CreateDeliveryControl" targetRef="DeliveryReceived" />
    <bpmn:sequenceFlow id="F16" sourceRef="DeliveryReceived" targetRef="End" />
    <bpmn:textAnnotation id="AnnTracker">
      <bpmn:text>Tracker: статусы, сроки, владелец, история и вложения</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="AnnMessenger">
      <bpmn:text>Messenger: уведомление владельцу процесса и инициатору, обновления в треде</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AssocTracker" sourceRef="AnnTracker" targetRef="RegisterRequest" />
    <bpmn:association id="AssocMessenger" sourceRef="AnnMessenger" targetRef="SendToFinance" />
    <bpmn:association id="Association_0e0v1bi" associationDirection="None" sourceRef="AnnTracker" targetRef="RegisterRequest" />
    <bpmn:association id="Association_067p5uy" associationDirection="None" sourceRef="AnnMessenger" targetRef="SendToFinance" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Mitlex_Procurement_Process">
      <bpmndi:BPMNShape id="L5" bpmnElement="Lane_Delivery" isHorizontal="true">
        <dc:Bounds x="160" y="740" width="2340" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L4" bpmnElement="Lane_Accounting" isHorizontal="true">
