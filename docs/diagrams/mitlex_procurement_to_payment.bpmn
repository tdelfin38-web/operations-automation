<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Mitlex" targetNamespace="https://mitlex.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:process id="Mitlex_Procurement_Process" name="Закупка материалов: от заявки до контроля поставки" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Mitlex">
      <bpmn:lane id="Lane_Initiator" name="Инициатор"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>CreateRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>ClarifyRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Снабжение"><bpmn:flowNodeRef>RegisterRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>RequestComplete</bpmn:flowNodeRef><bpmn:flowNodeRef>SelectSupplier</bpmn:flowNodeRef><bpmn:flowNodeRef>SendToFinance</bpmn:flowNodeRef><bpmn:flowNodeRef>ResolveSupplyIssue</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Финансы"><bpmn:flowNodeRef>ReviewBudget</bpmn:flowNodeRef><bpmn:flowNodeRef>InvoiceApproved</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Accounting" name="Бухгалтерия"><bpmn:flowNodeRef>PayInvoice</bpmn:flowNodeRef><bpmn:flowNodeRef>AttachPaymentOrder</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Delivery" name="Контроль поставки"><bpmn:flowNodeRef>CreateDeliveryControl</bpmn:flowNodeRef><bpmn:flowNodeRef>DeliveryReceived</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Потребность в материалах"/><bpmn:userTask id="CreateRequest" name="Создать заявку: материалы, объект, срок, вложения"/>
    <bpmn:userTask id="RegisterRequest" name="Зарегистрировать заявку и назначить ответственного"/><bpmn:exclusiveGateway id="RequestComplete" name="Заявка полная?"/>
    <bpmn:userTask id="ClarifyRequest" name="Уточнить заявку"/><bpmn:userTask id="SelectSupplier" name="Проверить потребность, выбрать поставщика и получить счёт"/><bpmn:userTask id="SendToFinance" name="Передать счёт на согласование"/>
    <bpmn:userTask id="ReviewBudget" name="Проверить бюджет и согласовать счёт"/><bpmn:exclusiveGateway id="InvoiceApproved" name="Счёт согласован?"/>
    <bpmn:userTask id="ResolveSupplyIssue" name="Уточнить условия / заменить поставщика"/><bpmn:userTask id="PayInvoice" name="Провести оплату"/><bpmn:userTask id="AttachPaymentOrder" name="Приложить платёжное поручение"/>
    <bpmn:userTask id="CreateDeliveryControl" name="Поставить задачу на контроль поставки"/><bpmn:userTask id="DeliveryReceived" name="Подтвердить поставку и закрывающие документы"/><bpmn:endEvent id="End" name="Заявка завершена"/>
    <bpmn:textAnnotation id="AnnTracker"><bpmn:text>Tracker: статусы, сроки, владелец, история и вложения</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="AnnMessenger"><bpmn:text>Messenger: уведомление владельцу процесса и инициатору, обновления в треде</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AssocTracker" sourceRef="AnnTracker" targetRef="RegisterRequest"/><bpmn:association id="AssocMessenger" sourceRef="AnnMessenger" targetRef="SendToFinance"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="CreateRequest"/><bpmn:sequenceFlow id="F2" sourceRef="CreateRequest" targetRef="RegisterRequest"/><bpmn:sequenceFlow id="F3" sourceRef="RegisterRequest" targetRef="RequestComplete"/><bpmn:sequenceFlow id="F4" name="Нет" sourceRef="RequestComplete" targetRef="ClarifyRequest"/><bpmn:sequenceFlow id="F5" sourceRef="ClarifyRequest" targetRef="RegisterRequest"/><bpmn:sequenceFlow id="F6" name="Да" sourceRef="RequestComplete" targetRef="SelectSupplier"/><bpmn:sequenceFlow id="F7" sourceRef="SelectSupplier" targetRef="SendToFinance"/><bpmn:sequenceFlow id="F8" sourceRef="SendToFinance" targetRef="ReviewBudget"/><bpmn:sequenceFlow id="F9" sourceRef="ReviewBudget" targetRef="InvoiceApproved"/><bpmn:sequenceFlow id="F10" name="Нет" sourceRef="InvoiceApproved" targetRef="ResolveSupplyIssue"/><bpmn:sequenceFlow id="F11" sourceRef="ResolveSupplyIssue" targetRef="SelectSupplier"/><bpmn:sequenceFlow id="F12" name="Да" sourceRef="InvoiceApproved" targetRef="PayInvoice"/><bpmn:sequenceFlow id="F13" sourceRef="PayInvoice" targetRef="AttachPaymentOrder"/><bpmn:sequenceFlow id="F14" sourceRef="AttachPaymentOrder" targetRef="CreateDeliveryControl"/><bpmn:sequenceFlow id="F15" sourceRef="CreateDeliveryControl" targetRef="DeliveryReceived"/><bpmn:sequenceFlow id="F16" sourceRef="DeliveryReceived" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Mitlex_Procurement_Process">
    <bpmndi:BPMNShape id="L1" bpmnElement="Lane_Initiator" isHorizontal="true"><dc:Bounds x="80" y="80" width="2050" height="140"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L2" bpmnElement="Lane_Procurement" isHorizontal="true"><dc:Bounds x="80" y="220" width="2050" height="140"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L3" bpmnElement="Lane_Finance" isHorizontal="true"><dc:Bounds x="80" y="360" width="2050" height="140"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L4" bpmnElement="Lane_Accounting" isHorizontal="true"><dc:Bounds x="80" y="500" width="2050" height="140"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L5" bpmnElement="Lane_Delivery" isHorizontal="true"><dc:Bounds x="80" y="640" width="2050" height="140"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="140" y="132" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Create" bpmnElement="CreateRequest"><dc:Bounds x="230" y="110" width="180" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Register" bpmnElement="RegisterRequest"><dc:Bounds x="480" y="250" width="185" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Complete" bpmnElement="RequestComplete" isMarkerVisible="true"><dc:Bounds x="725" y="265" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Clarify" bpmnElement="ClarifyRequest"><dc:Bounds x="830" y="110" width="145" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Supplier" bpmnElement="SelectSupplier"><dc:Bounds x="850" y="250" width="210" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Send" bpmnElement="SendToFinance"><dc:Bounds x="1120" y="250" width="175" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Review" bpmnElement="ReviewBudget"><dc:Bounds x="1360" y="390" width="185" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Approved" bpmnElement="InvoiceApproved" isMarkerVisible="true"><dc:Bounds x="1610" y="405" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Resolve" bpmnElement="ResolveSupplyIssue"><dc:Bounds x="1510" y="250" width="190" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Pay" bpmnElement="PayInvoice"><dc:Bounds x="1740" y="530" width="135" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Order" bpmnElement="AttachPaymentOrder"><dc:Bounds x="1930" y="530" width="155" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Control" bpmnElement="CreateDeliveryControl"><dc:Bounds x="1690" y="670" width="190" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Received" bpmnElement="DeliveryReceived"><dc:Bounds x="1930" y="670" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_End" bpmnElement="End"><dc:Bounds x="2040" y="132" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S_Ann1" bpmnElement="AnnTracker"><dc:Bounds x="300" y="385" width="260" height="55"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Ann2" bpmnElement="AnnMessenger"><dc:Bounds x="1010" y="530" width="300" height="55"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="E1" bpmnElement="F1"><di:waypoint x="176" y="150"/><di:waypoint x="230" y="150"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E2" bpmnElement="F2"><di:waypoint x="410" y="150"/><di:waypoint x="445" y="150"/><di:waypoint x="445" y="290"/><di:waypoint x="480" y="290"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E3" bpmnElement="F3"><di:waypoint x="665" y="290"/><di:waypoint x="725" y="290"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E4" bpmnElement="F4"><di:waypoint x="750" y="265"/><di:waypoint x="750" y="210"/><di:waypoint x="902" y="210"/><di:waypoint x="902" y="190"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E5" bpmnElement="F5"><di:waypoint x="830" y="150"/><di:waypoint x="700" y="150"/><di:waypoint x="700" y="235"/><di:waypoint x="572" y="235"/><di:waypoint x="572" y="250"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E6" bpmnElement="F6"><di:waypoint x="775" y="290"/><di:waypoint x="850" y="290"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E7" bpmnElement="F7"><di:waypoint x="1060" y="290"/><di:waypoint x="1120" y="290"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E8" bpmnElement="F8"><di:waypoint x="1295" y="290"/><di:waypoint x="1330" y="290"/><di:waypoint x="1330" y="430"/><di:waypoint x="1360" y="430"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E9" bpmnElement="F9"><di:waypoint x="1545" y="430"/><di:waypoint x="1610" y="430"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E10" bpmnElement="F10"><di:waypoint x="1635" y="405"/><di:waypoint x="1635" y="330"/><di:waypoint x="1605" y="330"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E11" bpmnElement="F11"><di:waypoint x="1510" y="290"/><di:waypoint x="1060" y="290"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E12" bpmnElement="F12"><di:waypoint x="1635" y="455"/><di:waypoint x="1635" y="570"/><di:waypoint x="1740" y="570"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E13" bpmnElement="F13"><di:waypoint x="1875" y="570"/><di:waypoint x="1930" y="570"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E14" bpmnElement="F14"><di:waypoint x="2008" y="610"/><di:waypoint x="2008" y="650"/><di:waypoint x="1785" y="650"/><di:waypoint x="1785" y="670"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E15" bpmnElement="F15"><di:waypoint x="1880" y="710"/><di:waypoint x="1930" y="710"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E16" bpmnElement="F16"><di:waypoint x="2090" y="710"/><di:waypoint x="2110" y="710"/><di:waypoint x="2110" y="150"/><di:waypoint x="2076" y="150"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
